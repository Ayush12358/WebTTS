{
    "functions": {
        "api/*.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/|@vite/|@react-refresh|src/|node_modules/|piper/|onnx/).*)",
            "destination": "/index.html"
        }
    ]
}